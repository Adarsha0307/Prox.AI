# Database configuration (SQLite file used by the API server)
# The default is server/sqlite.db; set this to use a disposable database.
# DATABASE_PATH=./sqlite.db

# Backend API Configuration
PORT=3001

# Signing secret for session tokens. REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# When unset outside production the server generates an ephemeral secret and
# warns on startup (all sessions are invalidated on restart).
AUTH_SECRET=

# Comma-separated list of browser origins allowed to call the API.
# Defaults to the local Vite dev/preview origins when unset.
# CORS_ORIGIN=http://localhost:5173

# Client Configuration
VITE_API_URL=http://localhost:3001

# AI Configuration
# Set OPENAI_API_KEY for server-side platform-funded AI generation.
# Users can also provide their own key via BYOK (Settings modal).
# OPENAI_API_KEY=sk-...

# Set to 'true' to enable platform-funded AI generation (deducts credits).
# ENABLE_PLATFORM_FUNDING=true

# Set to 'true' to enable mock AI responses when no API key is available.
# Useful for development/testing without a live OpenAI key.
MOCK_AI_PROVIDER=true
